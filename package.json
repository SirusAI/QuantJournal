{
  "name": "quantjournal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "setup:market-data": "node scripts/setup-market-data.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib scripts tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.cjs",
    "test:edge": "node --experimental-strip-types --test tests/edge-analysis.test.ts",
    "check:release": "node scripts/check-release.mjs",
    "demo:dev": "node scripts/prepare-demo-assets.mjs && vite --config demo/vite.config.mts",
    "demo:build": "node scripts/prepare-demo-assets.mjs && vite build --config demo/vite.config.mts",
    "demo:preview": "vite preview --config demo/vite.config.mts",
    "demo:typecheck": "tsc --noEmit -p demo/tsconfig.json",
    "video:studio": "remotion studio media/index.ts",
    "video:render": "remotion render media/index.ts QuantJournalTour public/media/quantjournal-tour.mp4 --codec=h264 --pixel-format=yuv420p --crf=23",
    "video:poster": "remotion still media/index.ts QuantJournalTour public/media/quantjournal-poster.png --frame=90"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.563.0",
    "next": "16.1.4",
    "papaparse": "^5.5.3",
    "prisma": "^5.10.0",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.535",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "remotion": "^4.0.535",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
